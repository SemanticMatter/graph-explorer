{
  "name": "rdf-graph-explorer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:compile": "tsc -p tsconfig.test.json && echo '{\"type\":\"commonjs\"}' > .test-dist/package.json",
    "test:run": "node --test .test-dist/tests/**/*.test.js",
    "test": "npm run test:compile && npm run test:run",
    "test:coverage": "npm run test:compile && node --test --experimental-test-coverage .test-dist/tests/**/*.test.js",
    "test:ci": "npm run test:coverage"
  },
  "dependencies": {
    "react-dom": "^19.2.4",
    "react": "^19.2.4",
    "lucide-react": "^0.564.0",
    "cytoscape": "^3.33.1",
    "n3": "^2.0.1",
    "react-cytoscapejs": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.2"
  }
}
